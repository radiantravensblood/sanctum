{
  "name": "Velastra Cloud Atelier",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python3 -m pip install --user -r labs/velastra/painter/requirements-provider.txt",
  "secrets": {
    "HF_TOKEN": {
      "description": "Hugging Face fine-grained token with Make calls to Inference Providers permission.",
      "documentationUrl": "https://huggingface.co/settings/tokens"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
