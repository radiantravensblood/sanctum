    "codespaceCredentialMustRemainSecret": true,
    "cloudHandoffMustRemainEphemeral": true,
    "virynismMustTravelInsideManifest": true,
    "styleCannotChangeCanonicalPlaceIdentity": true,
    "styleChangeMustChangeCandidateIdentity": true,
    "brushDialectMayTranslateButNotOverrideStyle": true,
    "painterlyTruthMustTravelInsideManifest": true,
    "painterlyTruthMayChangeCanonicalPlaceIdentity": true,
    "painterlyTruthCannotBeStyleDirective": true,
    "portableObjectsCannotEnterCanonicalPlaceTruth": true,
    "fixedObjectsMayEnterCanonicalPlaceTruth": true,
    "visibleEvidenceMustTravelInsideManifest": true,
    "visibleEvidenceCannotChangeCanonicalPlaceIdentity": true,
    "visibleEvidenceChangeMustChangeCandidateIdentity": true,
    "visibleEvidenceMustUsePositivePromptChannel": true,
    "brushControlContractMustBeExplicit": true,
    "unsupportedNegativeChannelCannotCarryCriticalMeaning": true,
    "promptBudgetMustPreserveSceneAndEvidence": true,
    "visualWitnessMustTravelInsideManifest": true,
    "visualWitnessCannotChangeCanonicalPlaceIdentity": true,
    "visualWitnessChangeMustChangeCandidateIdentity": true,
    "witnessContentCannotBecomeSceneTruth": true,
    "witnessAssetRequiresApprovalAndSha256": true,
    "missingWitnessMustFallBackForTextBrushes": true,
    "witnessBrushMustFailClosedWithoutApprovedAsset": true,
    "nondeterministicWitnessRenderMustCarryAttemptIdentity": true,
    "visualWitnessMayGuideHandButNotScene": true,
    "handprintMustTravelInsideManifest": true,
    "handprintCannotChangeCanonicalPlaceIdentity": true,
    "handprintChangeMustChangeCandidateIdentity": true,
    "handprintCannotBecomeSceneTruth": true,
    "handprintCannotOverridePainterlyTruth": true,
    "handprintCannotOverrideVisibleEvidence": true,
    "handprintPixelMetricsMustRemainAuditable": true,
    "handprintCorpusMustUseApprovedSealedWitnesses": true,
    "insufficientHandprintCorpusMustFailSoft": true,
    "handprintFacetProjectionMustRemainSceneRelevant": true,
    "handprintFacetRangesCannotBeCollapsedIntoUniversalTargets": true,
    "provisionalSingleWitnessFacetCannotDriveRender": true,
    "renderAblationMustNotMutateManifestOrCanon": true,
    "textFirstBrushCannotClaimUnsentWitnessPixels": true,
    "handprintPressureMustBeManifestAuthored": true,
    "handprintPressureCannotOverrideSceneTruth": true,
    "handprintPressureCannotOverrideVisibleEvidence": true,
    "combinedWitnessMustYieldLiteralReconstructionToFacetLaw": true,
    "pressureModeMustEnterCandidateProvenance": true,
    "witnessOnlyAblationMustCarryNoHandprintPressure": true,
    "textFirstHandprintMustRemainDescriptiveRatherThanPretendReferenceControl": true,
    "stochasticTransportRequiresReplicationForCalibration": true,
    "pressureCalibrationMustFreezeHandprint": true,
    "pressureCalibrationMustFreezeVisualWitnessCanon": true,
    "pressureCalibrationMustFreezeSceneTruth": true,
    "candidateEvaluationCannotPromoteAsset": true,
    "metricScoreCannotReplaceHumanReview": true,
    "spatialSimilarityCannotEstablishSemanticCopying": true,
    "trialPlanningCannotExecuteInference": true,
    "trialResultsMustRemainAuthoringEvidence": true,
    "gripMustTravelInsideManifest": true,
    "gripCannotChangeCanonicalPlaceIdentity": true,
    "gripCannotBecomeSceneTruth": true,
    "gripCannotOverridePainterlyTruth": true,
    "gripCannotOverrideVisibleEvidence": true,
    "gripCannotOverrideHumanReview": true,
    "gripAnchorCannotFreezeExactValue": true,
    "gripFreedomCannotBecomeRandomnessDirective": true,
    "gripTendencyCannotBecomeCompulsoryMotif": true,
    "oneSceneGripCannotBecomeGlobalLaw": true,
    "pendingHumanReviewGripCannotDriveRender": true,
    "handprintGripIsObservationOnlyInKernel0031": true,
    "handprintGripCannotDrivePainterPromptInKernel0031": true,
    "handprintGripCannotChangeCandidateIdentityWhileObservational": true,
    "handprintGripRenderActivationRequiresFutureCrossSceneReplication": true,
    "gripObservationMustNotChangeCandidateIdentity": true,
    "crossSceneGripReplicationMustHoldFrozenControls": true,
    "crossSceneGripReplicationRequiresDifferentAssetIdentity": true,
    "crossSceneGripMatchCannotActivateRenderLaw": true,
    "crossSceneGripChangeMayIndicateSceneDependence": true,
    "signatureLikeArtifactMustRemainHumanObservation": true,
    "signatureLikeArtifactCannotEstablishAuthorship": true
  },
