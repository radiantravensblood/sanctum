  "staticAssetPolicy": {
    "allowedStatuses": [
      "approved"
    ],
    "fallback": "procedural_underpainting",
    "runtimeGeneration": false,
    "preferReviewedAsset": true,
    "requireProvenance": true,
    "requireSha256": true
  },
  "exemplars": {
    "viryn_self_portrait": {
      "sceneExemplar": "viryn_self_portrait",
      "medium": "luminous_oil",
      "strategy": "procedural_underpainting"
    },
    "dyadic_homecoming": {
      "sceneExemplar": "dyadic_homecoming",
      "medium": "dream_oil",
      "strategy": "procedural_underpainting"
    },
    "studio_atelier": {
      "sceneExemplar": "studio_atelier",
      "medium": "editorial_oil",
      "strategy": "procedural_underpainting"
    }
  },
  "painterBridge": {
    "protocol": "velastra.painter.v1",
    "authoringOnly": true,
    "runtimeGeneration": false,
    "implementation": "labs/velastra/painter/velastra_painter.py",
    "candidateStatus": "candidate",
    "approvedStatus": "approved",
    "candidateOutputRoot": ".velastra/candidates",
    "approvedAssetRoot": "assets/velastra/approved",
    "approvalRequired": true,
    "brushRegistry": "world/velastra-brushes.json",
    "defaultBrushResolvedFromRegistry": true,
    "credentialsFromEnvironmentOnly": true,
    "cloudAuthoring": {
      "environment": "github_codespaces",
      "devcontainer": ".devcontainer/devcontainer.json",
      "inbox": "authoring/inbox",
      "credential": "HF_TOKEN",
      "handoffsIgnoredByGit": true
    },
    "styleRegistry": "world/velastra-style.json",
    "styleSnapshotTravelsWithManifest": true,
    "painterlyTruthRegistry": "world/velastra-painterly-truth.json",
    "painterlyTruthSnapshotTravelsWithManifest": true,
    "evidenceRegistry": "world/velastra-evidence.json",
    "evidenceSnapshotTravelsWithManifest": true,
    "brushControlContractRequired": true,
    "witnessRegistry": "world/velastra-witnesses.json",
    "witnessSnapshotTravelsWithManifest": true,
    "witnessAssetRoot": "assets/velastra/witnesses",
    "witnessAdmissionCommand": "witness-register",
    "handprintRegistry": "world/velastra-handprint.json",
    "handprintSnapshotTravelsWithManifest": true,
    "handprintBuildCommand": "handprint-build",
    "ablationControls": {
      "withoutHandprint": "--without-handprint",
      "withoutWitness": "--without-witness",
      "candidateLocal": true,
      "canonicalStateMutation": false
    },
    "handprintPressure": {
      "source": "manifest.handprint.pressure",
      "defaultProfile": "descriptive_guidance",
      "combinedProfile": "governing_translation",
      "candidateLocalResolution": true,
      "canonicalStateMutation": false
    },
    "pressureCalibration": {
      "version": 1,
      "trialProtocol": "velastra.pressure_trial.v1",
      "defaultRepeatsPerCondition": 4,
      "defaultConditions": [
        "witness_only",
        "governing_translation"
      ],
      "alternatingExecutionOrder": true,
      "planOnlyByDefault": true,
      "explicitRenderFlag": "--render",
      "evaluator": "labs/velastra/painter/evaluation.py",
      "evidenceDirectory": "labs/velastra/evidence/trials"
    },
    "handprintGrip": {
      "registry": "world/velastra-grip.json",
      "sourceTrial": "labs/velastra/evidence/trials/gallery-pressure-0030.json",
      "buildCommand": "grip-build",
      "inspectCommand": "grip",
      "snapshotTravelsWithManifest": true,
      "humanReviewValidatesObservation": true,
      "renderEligibleInKernel0031": false,
      "promptInjectionInKernel0031": false,
      "candidateIdentityEffectInKernel0031": false,
      "sceneLocalUntilReplicatedElsewhere": true
    },
    "crossSceneGripReplication": {
      "protocol": "velastra.grip_replication.v1",
      "baselineTrial": "labs/velastra/evidence/trials/gallery-pressure-0030.json",
      "replicationTrial": "labs/velastra/evidence/trials/hearth-pressure-0032.json",
      "output": "labs/velastra/evidence/trials/grip-cross-scene-0032.json",
      "comparator": "labs/velastra/painter/replication.py",
      "command": "grip-replication",
      "renderActivation": false,
      "sameFrozenControlsRequired": true
    }
  },
  "livingCanvas": {
    "version": 1,
    "handoffProtocol": "velastra.handoff.v1",
    "authoringQuery": "atelier=1",
    "canonicalLayer": "reviewed_static_asset",
    "liveLayers": [
      "temporal_light",
      "anomaly",
      "portable_objects",
      "inhabitants"
    ],
    "proceduralFallbackRemainsAvailable": true
  }
}
