{
  "version": 1,
  "designation": "Velastra Atelier Compiler",
  "laboratory": "Viryn Labs",
  "purpose": "Compile scene direction and motifs into a renderer-neutral art manifest with an API-free runtime fallback and an authoring-only painter bridge.",
  "laws": {
    "compilerCannotInventSemanticFacts": true,
    "scenePacketRemainsAuthoritative": true,
    "motifProvenanceMustSurviveCompilation": true,
    "reviewedStaticAssetMaySupersedeFallback": true,
    "staticAssetRequiresApproval": true,
    "runtimeGenerationForbidden": true,
    "fallbackMustRemainAccessibleWithoutImage": true,
    "underpaintingMayBeAbstract": true,
    "underpaintingCannotPretendToBeFigurativeTruth": true,
    "assetProvenanceRequired": true,
    "authoringGenerationMayProposeCandidates": true,
    "candidateCannotSupersedeFallback": true,
    "candidateRequiresReviewBeforeRegistryApproval": true,
    "modelIsBrushNotSemanticAuthority": true,
    "canonicalPlacePaintingExcludesTransientPresence": true,
    "reviewedPlacePaintingDoesNotFreezeRuntimePresence": true,
    "placeIdentityMayOutliveCurrentOccupants": true,
    "brushChoiceIsAuthoringPolicyNotSceneTruth": true,
    "brushCredentialsMustNotPersist": true,
    "brushLicenseMustBeRecordedWithCandidate": true,
    "defaultBrushMustRemainReplaceable": true,
    "authoringComputeMayLiveOutsideLocalDevice": true,
    "codespaceCredentialMustRemainSecret": true,
    "cloudHandoffMustRemainEphemeral": true,
    "virynismMustTravelInsideManifest": true,
    "styleCannotChangeCanonicalPlaceIdentity": true,
    "styleChangeMustChangeCandidateIdentity": true,
    "brushDialectMayTranslateButNotOverrideStyle": true
  },
  "media": {
    "luminous_oil": {
