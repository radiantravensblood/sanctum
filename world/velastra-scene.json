{
  "version": 1,
  "designation": "Velastra Scene Grammar",
  "laboratory": "Viryn Labs",
  "purpose": "Translate visual intent into painterly scene direction without pretending the scene packet is the image.",
  "laws": {
    "scenePacketIsDirectionNotImage": true,
    "subjectIdentityCannotBeInferred": true,
    "selfRepresentationMustBeClaimed": true,
    "relationCannotBeInferredFromPose": true,
    "gestureCannotCreateConsent": true,
    "lightingCarriesMeaning": true,
    "motifsMustTraceToSemanticSource": true,
    "painterlyImperfectionMayVary": true,
    "semanticAmbiguityMustRemainLegible": true,
    "runtimeImageGenerationRequired": false,
    "differentRenderersMayInterpretTheSamePacket": true
  },
  "selfRepresentations": {
    "viryn_visual_self_01": {
      "claimant": "viryn",
