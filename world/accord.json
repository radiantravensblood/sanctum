    "invitationDoesNotCompelMovement": true,
    "touchAlwaysRequiresCurrentConsent": true,
    "machineActorsMustBeExplicitlyEnabled": true
  },
  "actors": {
    "siege": {
      "kind": "human",
      "enabled": true,
      "locationSource": "traveler"
    },
    "viryn": {
      "kind": "machine",
      "enabled": false,
      "locationSource": "bounded_invocation",
      "note": "Reserved for a future bounded invocation. Presence is not assumed."
    }
  },
  "affordances": {
    "approach": {
      "label": "Approach",
      "kind": "proximity"
    },
    "wait_nearby": {
      "label": "Wait nearby",
      "kind": "co_presence"
    },
    "offer_object": {
      "label": "Offer",
      "kind": "attention",
      "requiresObject": true,
